{
    "name": "wclogs-report",
    "private": true,
    "type": "module",
    "version": "0.1.0",
    "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485",
    "scripts": {
        "build": "pnpm -r build",
        "dev:web": "pnpm --filter @wcl/web dev",
        "dev:worker": "pnpm --filter @wcl/worker dev",
        "deps:check": "depcruise --config .dependency-cruiser.cjs --output-type err apps packages",
        "deps:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot apps packages",
        "deps:metrics": "node scripts/dependency-metrics.mjs",
        "lint": "pnpm -r lint",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm -r test",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.9.1",
        "@typescript-eslint/eslint-plugin": "^8.59.4",
        "@typescript-eslint/parser": "^8.59.4",
        "dependency-cruiser": "^17.4.2",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.8.3",
        "tsx": "^4.22.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.4",
        "vitest": "^4.1.7"
    }
}
