{
    "name": "@wcl/web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm build:server && pnpm build:client",
        "build:client": "vite build --config vite.config.ts",
        "build:server": "tsc -p tsconfig.json",
        "dev": "tsx watch src/index.ts",
        "dev:client": "vite --config vite.config.ts",
        "dev:dashboard": "vite --config vite.config.ts",
        "start": "node dist/server/apps/web/src/index.js",
        "lint": "eslint src client --ext .ts,.tsx",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
        "test": "vitest run --passWithNoTests --config vitest.config.ts",
        "register:discord-commands": "tsx src/ops/register-discord-commands.ts"
    },
    "dependencies": {
        "@fastify/cookie": "^11.0.2",
        "@fastify/static": "^9.1.3",
        "@wcl/db": "workspace:*",
        "@wcl/discord": "workspace:*",
        "@wcl/domain": "workspace:*",
        "@wcl/shared": "workspace:*",
        "@wcl/wcl-client": "workspace:*",
        "discord-interactions": "^4.1.0",
        "dotenv": "^17.4.1",
        "fastify": "^5.2.1",
        "fastify-raw-body": "^5.0.0",
        "react": "^19.2.5",
        "react-dom": "^19.2.5"
    },
    "devDependencies": {
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "vite": "^8.0.10"
    }
}
