{
    "name": "@wcl/web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build:deps": "pnpm --filter @wcl/shared build && pnpm --filter @wcl/domain build && pnpm --filter @wcl/wcl-client build && pnpm --filter @wcl/db build && pnpm --filter @wcl/discord build",
        "build": "pnpm build:server && pnpm build:client",
        "build:client": "vite build --config vite.config.ts",
        "build:server": "pnpm run build:deps && tsc -p tsconfig.build.json",
        "dev": "tsx watch --tsconfig tsconfig.dev.json src/index.ts",
        "dev:client": "vite --config vite.config.ts",
        "dev:dashboard": "vite --config vite.config.ts",
        "start": "node dist/server/src/index.js",
        "lint": "eslint src client --ext .ts,.tsx",
        "typecheck": "pnpm run build:deps && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
        "test": "vitest run --passWithNoTests --config vitest.config.ts",
        "register:discord-commands": "tsx --tsconfig tsconfig.dev.json src/ops/register-discord-commands.ts"
    },
    "dependencies": {
        "@fastify/cookie": "^11.0.2",
        "@fastify/static": "^9.1.3",
        "@wcl/db": "workspace:*",
        "@wcl/discord": "workspace:*",
        "@wcl/domain": "workspace:*",
        "@wcl/shared": "workspace:*",
        "@wcl/wcl-client": "workspace:*",
        "discord-interactions": "^4.4.0",
        "dotenv": "^17.4.2",
        "fastify": "^5.8.5",
        "fastify-raw-body": "^5.0.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6"
    },
    "devDependencies": {
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "vite": "^8.0.13"
    }
}
