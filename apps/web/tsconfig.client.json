{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "types": ["vite/client"],
        "allowImportingTsExtensions": true,
        "declaration": false,
        "declarationMap": false,
        "noEmit": true
    },
    "include": ["client/src/**/*.ts", "client/src/**/*.tsx"]
}
