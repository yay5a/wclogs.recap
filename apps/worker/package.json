{
    "name": "@wcl/worker",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm --filter @wcl/shared build && pnpm --filter @wcl/domain build && pnpm --filter @wcl/wcl-client build && pnpm --filter @wcl/db build && pnpm --filter @wcl/discord build && tsc -p tsconfig.json",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/apps/worker/src/index.js",
        "probe:guild-report-metadata-index": "tsx scripts/probe-guild-report-metadata-index.ts",
        "probe:guild-encounter-trends": "tsx scripts/probe-guild-encounter-trends.ts",
        "lint": "eslint src --ext .ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "@wcl/db": "workspace:*",
        "@wcl/discord": "workspace:*",
        "@wcl/shared": "workspace:*",
        "@wcl/wcl-client": "workspace:*",
        "discord.js": "^14.26.3",
        "dotenv": "^17.4.1"
    }
}
