{
    "name": "@wcl/wcl-client",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/wcl-client/src/index.js",
    "types": "dist/wcl-client/src/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "lint": "eslint src --ext .ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --passWithNoTests",
        "probe:report": "tsx scripts/probe-report.ts",
        "probe:guildrank": "tsx scripts/probe-guildrank.ts",
        "probe:guild-report-index": "tsx scripts/probe-guild-report-index.ts",
        "probe:v1-guild-rankings": "tsx scripts/probe-v1-guild-rankings.ts",
        "probe:guildrank-schema": "tsx scripts/probe-guildrank-schema.ts"
    },
    "dependencies": {
        "@wcl/domain": "workspace:*",
        "@wcl/shared": "workspace:*",
        "graphql-request": "^7.1.2"
    }
}
