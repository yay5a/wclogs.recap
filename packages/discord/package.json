        "preview:report": "pnpm dlx browser-sync start --server dev/report-preview --startPath /report-renderer.html --files 'dev/report-preview/*'"
    },
    "dependencies": {
        "@wcl/domain": "workspace:*",
        "@wcl/shared": "workspace:*",
        "@wcl/wcl-client": "workspace:*",
        "discord-interactions": "^4.4.0",
        "playwright-chromium": "^1.60.0"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.0",
        "tailwindcss": "^4.3.0"
    }
}
