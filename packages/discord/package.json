{
    "name": "@wcl/discord",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/discord/src/index.js",
    "types": "dist/discord/src/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "lint": "eslint src --ext .ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
